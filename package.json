{
  "name": "sample-notifier-service",
  "version": "2.0.0",
  "description": "A durable browser notification tutorial and provider-neutral production starter.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/start-api.js",
    "start:worker": "node src/start-worker.js",
    "dev": "node --watch src/start-api.js",
    "dev:worker": "node --watch src/start-worker.js",
    "test": "node --test test/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.js",
    "test:all": "npm test && npm run test:integration"
  },
  "dependencies": {
    "bullmq": "5.81.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jose": "6.2.4",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "socket.io-client": "4.8.3"
  },
  "license": "Apache-2.0"
}
